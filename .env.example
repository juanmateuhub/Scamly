# Copy to .env and fill in. Never commit .env.

# LLM provider: "ollama" (local, default) or "gemini"
LLM_PROVIDER=ollama
LLM_TIMEOUT_S=8

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Gemini (only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=

# CORS: Chrome extension ID allowed to call the backend
EXTENSION_ID=
