# Copy to .env and fill in. Never commit .env.

# LLM: any OpenAI-compatible API. Default: OpenRouter free Gemma 4 31B.
# Leave LLM_API_KEY empty to run with Spanish phrase rules only (plan B).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
LLM_API_KEY=
LLM_TIMEOUT_S=8
# OpenRouter only: tried in order when the primary free model is rate-limited upstream.
# Leave empty for Ollama or other providers.
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free
# OpenRouter only: skip "thinking" tokens (median latency ~12 s -> ~2 s). Set false for Ollama.
LLM_DISABLE_REASONING=true

# Local alternative with Ollama (no key needed, any non-empty value works):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# Cache of LLM findings (hours)
CACHE_TTL_HOURS=24

# CORS: Chrome extension ID allowed to call the backend
EXTENSION_ID=
