{
  "manifest_version": 3,
  "name": "Scamly",
  "version": "0.1.0",
  "description": "Puntúa el riesgo de estafa del anuncio abierto en Wallapop o Vinted y explica los motivos.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Scamly: analizar este anuncio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
