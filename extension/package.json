{
  "name": "scamly-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that shows the scam risk of the open Wallapop or Vinted listing",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings .",
    "build": "tsc --noEmit && vite build && vite build -c vite.content.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite --port 5173 --strictPort --open /dev/panel-preview.html"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "happy-dom": "21.0.4",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
